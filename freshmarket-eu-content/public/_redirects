# Netlify _redirects
# Dokumentacja: https://docs.netlify.com/routing/redirects/

# Stare adresy z router.php → nowe ścieżki Astro
# (uzupełnij listę po porównaniu sitemap starej strony z nową)
/index.php                       /                            301
/?lang=en                        /                            301
/?lang=pl                        /pl/                         301
/registration.php                /registration                301
/contact.php                     /contact                     301
/agenda.php                      /agenda                      301
/award.php                       /award                       301

# Decap CMS — krótki alias
/cms                             /admin/                      301

# Aplikacja B2B (subdomena)
/app/*                           https://app.freshmarket.eu/:splat   301!

# Domyślny fallback dla SPA-style 404 (Astro generuje 404.html, więc tu nic nie potrzebujemy)
