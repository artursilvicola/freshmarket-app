---
interface Props {
  title: string;
  subtitle?: string;
  notice?: string;
  background_video?: string;
  image?: string;
  ctas?: Array<{ label: string; href: string; primary?: boolean }>;
  cta?: { label: string; href: string };
}

const { title, subtitle, notice, background_video, image, ctas, cta } = Astro.props;
const allCtas = ctas || (cta ? [{ ...cta, primary: true }] : []);
---
<section class="relative bg-brand-700 text-white overflow-hidden min-h-[480px]">
  {background_video && (
    <video
      class="absolute inset-0 w-full h-full object-cover opacity-30"
      autoplay muted loop playsinline
      src={background_video}
    />
  )}
  {!background_video && image && (
    <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover opacity-40" />
  )}
  <div class="relative container-wide py-16 lg:py-24">
    <div class="max-w-2xl bg-brand-700/80 backdrop-blur-sm p-8 rounded">
      <h1 class="text-3xl lg:text-4xl font-bold mb-6 leading-tight">{title}</h1>
      {subtitle && (
        <p class="text-yellow-300 text-lg font-semibold mb-4">{subtitle}</p>
      )}
      {notice && (
        <p class="text-sm text-brand-100 mb-6">{notice}</p>
      )}
      {allCtas.length > 0 && (
        <div class="flex flex-wrap gap-3">
          {allCtas.map(c => (
            <a href={c.href} class={c.primary ? 'btn-primary' : 'btn-secondary'}>
              {c.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
