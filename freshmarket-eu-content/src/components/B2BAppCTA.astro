---
// CTA do aplikacji B2B (PreConnect / matchmaking).
// Adres: app.freshmarket.eu — osobny deploy Netlify (freshmarketb2b.netlify.app pod custom domain).
// Wstawić na stronach: index, registration, exhibitors-hub, distributors-hub, retail-chains-hub.
import type { Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
  variant?: 'banner' | 'card';
}

const { locale, variant = 'card' } = Astro.props;

const labels = locale === 'pl'
  ? {
      title: 'Aplikacja PreConnect — matchmaking dostawca ↔ kupiec',
      desc: 'Po rejestracji otrzymujesz dostęp do panelu B2B: profile firm, oferty produktów, agenda spotkań, kalendarz Speed Datingu.',
      cta: 'Otwórz aplikację B2B →',
      bullet_supplier: 'Dla dostawców: prześlij oferty kupcom przed wydarzeniem',
      bullet_buyer: 'Dla kupców: przegląd ofert, plan spotkań, decyzje',
      bullet_admin: 'Dla organizatora: pełna kontrola matchmakingu',
    }
  : {
      title: 'PreConnect app — supplier ↔ buyer matchmaking',
      desc: 'After registration you get access to the B2B panel: company profiles, product offers, meeting agenda, Speed Dating calendar.',
      cta: 'Open B2B app →',
      bullet_supplier: 'For suppliers: send offers to buyers before the event',
      bullet_buyer: 'For buyers: browse offers, plan meetings, decide',
      bullet_admin: 'For organizer: full matchmaking control',
    };

const appUrl = 'https://app.freshmarket.eu';
---

{variant === 'banner' ? (
  <section class="bg-gradient-to-r from-brand-700 to-brand-600 text-white py-12 px-4">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-6 justify-between">
      <div>
        <h3 class="text-2xl font-bold mb-2">{labels.title}</h3>
        <p class="text-white/90">{labels.desc}</p>
      </div>
      <a
        href={appUrl}
        target="_blank"
        rel="noopener"
        class="bg-accent-500 hover:bg-accent-600 text-white font-semibold px-8 py-4 rounded-lg whitespace-nowrap transition-colors"
      >
        {labels.cta}
      </a>
    </div>
  </section>
) : (
  <div class="bg-white border-2 border-brand-100 rounded-xl p-6 shadow-sm">
    <h3 class="text-xl font-bold text-brand-700 mb-3">{labels.title}</h3>
    <p class="text-gray-700 mb-4">{labels.desc}</p>
    <ul class="text-sm text-gray-600 space-y-1 mb-6">
      <li>• {labels.bullet_supplier}</li>
      <li>• {labels.bullet_buyer}</li>
      <li>• {labels.bullet_admin}</li>
    </ul>
    <a
      href={appUrl}
      target="_blank"
      rel="noopener"
      class="inline-block bg-brand-700 hover:bg-brand-800 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
    >
      {labels.cta}
    </a>
  </div>
)}
