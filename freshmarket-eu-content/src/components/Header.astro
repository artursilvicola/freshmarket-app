---
import { t, type Locale } from '../i18n/translations';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const tr = t(locale);
const prefix = locale === 'pl' ? '/pl' : '';

const mainNav = [
  { label: tr.nav.how_it_works, href: `${prefix}/how-freshmarket-works`, hasSubmenu: true },
  { label: tr.nav.exhibition, href: `${prefix}/exhibition` },
  { label: tr.nav.registration, href: `${prefix}/registration` },
  { label: tr.nav.award, href: `${prefix}/award` },
  { label: tr.nav.contact, href: `${prefix}/contact` },
];

const submenuItems = [
  { label: tr.nav.reviews, href: `${prefix}/reviews` },
  { label: tr.nav.agenda, href: `${prefix}/agenda` },
  { label: tr.nav.distributors_hub, href: `${prefix}/distributors-hub` },
  { label: tr.nav.retail_chains_hub, href: `${prefix}/retail-chains-hub` },
  { label: tr.nav.participants, href: `${prefix}/participants` },
  { label: tr.nav.exhibitors_hub, href: `${prefix}/exhibitors-hub` },
  { label: tr.nav.venue, href: `${prefix}/venue` },
  { label: tr.nav.important_dates, href: `${prefix}/important-dates` },
  { label: tr.nav.gallery, href: `${prefix}/gallery` },
  { label: tr.nav.regulation, href: `${prefix}/regulation` },
];

const otherLocale = locale === 'en' ? 'pl' : 'en';
const otherLocaleHref = locale === 'en' ? '/pl' : '/';
---
<header class="bg-brand-700 text-white">
  <div class="container-wide flex items-center justify-between py-3">
    <a href={prefix || '/'} class="flex items-center gap-3">
      <img src="/assets/logo-freshmarket-2026.svg" alt="Fresh Market 2026" class="h-12 w-auto" />
    </a>
    <div class="hidden lg:flex flex-col items-end text-right text-xs leading-tight">
      <span class="font-bold">XX<sup>TH</sup> EDITION</span>
      <span class="text-yellow-300 text-lg font-bold">24 SEPTEMBER 2026</span>
      <span>WARSAW, POLAND</span>
    </div>
  </div>

  <nav class="bg-white border-t border-brand-700 text-slate-800">
    <div class="container-wide flex items-center justify-between py-3">
      <ul class="flex items-center gap-1 lg:gap-6">
        <li class="flex items-center gap-2">
          <a href="/" class={locale === 'en' ? 'opacity-100' : 'opacity-50'}>
            <img src="/assets/flags/en.svg" alt="EN" class="h-5 w-auto" />
          </a>
          <a href="/pl" class={locale === 'pl' ? 'opacity-100' : 'opacity-50'}>
            <img src="/assets/flags/pl.svg" alt="PL" class="h-5 w-auto" />
          </a>
        </li>
        {mainNav.map(item => (
          <li class="relative group">
            <a href={item.href} class="px-3 py-2 hover:text-brand-700 font-medium">{item.label}</a>
            {item.hasSubmenu && (
              <ul class="absolute left-0 top-full hidden group-hover:block bg-white border border-slate-200 shadow-lg rounded-md py-2 min-w-[240px] z-50">
                {submenuItems.map(sub => (
                  <li>
                    <a href={sub.href} class="block px-4 py-2 text-sm hover:bg-brand-50">{sub.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>
