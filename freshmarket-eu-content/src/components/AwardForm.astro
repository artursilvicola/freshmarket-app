---
// Fresh Market Award — formularz zgłoszeniowy.
// Tryb: dane podstawowe + krótki opis. Pliki (PDF, zdjęcia) NIE są wysyłane przez Netlify Forms
// (limit 8 MB / submission, brak obsługi multi-file). Zamiast tego: link do folderu
// (Google Drive / Dropbox / WeTransfer) — uczestnik podaje link.
import type { Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const labels = locale === 'pl'
  ? {
      title: 'Zgłoszenie produktu — Fresh Market Award 2026',
      category: 'Kategoria',
      cat_new_product: 'Nowa odmiana / nowy produkt',
      cat_packaging: 'Najlepsza innowacja w opakowaniu',
      cat_sustainability: 'Nagroda za zrównoważony rozwój',
      cat_retail_ready: 'Najlepsze rozwiązanie retail-ready',
      cat_service: 'Usługa / technologia roku',
      product_name: 'Nazwa produktu',
      company: 'Firma',
      contact_person: 'Osoba kontaktowa',
      email: 'Email',
      phone: 'Telefon',
      description: 'Krótki opis (max 500 znaków)',
      assets_url: 'Link do plików (zdjęcia, opis, prezentacja) — Google Drive / Dropbox / WeTransfer',
      assets_url_help: 'Wymagane: minimum 3 zdjęcia produktu w wysokiej rozdzielczości + opis (PDF lub Word).',
      accept: 'Akceptuję regulamin Fresh Market Award',
      submit: 'Wyślij zgłoszenie',
    }
  : {
      title: 'Product entry — Fresh Market Award 2026',
      category: 'Category',
      cat_new_product: 'New variety / new product',
      cat_packaging: 'Best packaging innovation',
      cat_sustainability: 'Sustainability award',
      cat_retail_ready: 'Best retail-ready solution',
      cat_service: 'Service / technology of the year',
      product_name: 'Product name',
      company: 'Company',
      contact_person: 'Contact person',
      email: 'Email',
      phone: 'Phone',
      description: 'Short description (max 500 characters)',
      assets_url: 'Link to files (photos, description, presentation) — Google Drive / Dropbox / WeTransfer',
      assets_url_help: 'Required: minimum 3 high-resolution product photos + description (PDF or Word).',
      accept: 'I accept the Fresh Market Award terms',
      submit: 'Submit entry',
    };

const successHref = locale === 'pl' ? '/pl/award?sent=1' : '/award?sent=1';
const inputCls = 'w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-brand-500 focus:border-brand-500';
---

<form
  name="award"
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  action={successHref}
  class="space-y-4 bg-white p-6 rounded-xl shadow-sm border border-gray-200"
>
  <input type="hidden" name="form-name" value="award" />
  <input type="hidden" name="locale" value={locale} />
  <p class="hidden"><label>Don't fill: <input name="bot-field" /></label></p>

  <h3 class="text-xl font-bold text-brand-700 mb-2">{labels.title}</h3>

  <div>
    <label class="block text-sm font-medium mb-1" for="aw-category">{labels.category} *</label>
    <select id="aw-category" name="category" required class={inputCls}>
      <option value="new_product">{labels.cat_new_product}</option>
      <option value="packaging">{labels.cat_packaging}</option>
      <option value="sustainability">{labels.cat_sustainability}</option>
      <option value="retail_ready">{labels.cat_retail_ready}</option>
      <option value="service">{labels.cat_service}</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium mb-1" for="aw-product">{labels.product_name} *</label>
    <input id="aw-product" type="text" name="product_name" required class={inputCls} />
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1" for="aw-company">{labels.company} *</label>
      <input id="aw-company" type="text" name="company" required class={inputCls} />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="aw-contact">{labels.contact_person} *</label>
      <input id="aw-contact" type="text" name="contact_person" required class={inputCls} />
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1" for="aw-email">{labels.email} *</label>
      <input id="aw-email" type="email" name="email" required class={inputCls} />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="aw-phone">{labels.phone}</label>
      <input id="aw-phone" type="tel" name="phone" class={inputCls} />
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium mb-1" for="aw-desc">{labels.description} *</label>
    <textarea id="aw-desc" name="description" rows="4" maxlength="500" required class={inputCls} />
  </div>

  <div>
    <label class="block text-sm font-medium mb-1" for="aw-assets">{labels.assets_url} *</label>
    <input id="aw-assets" type="url" name="assets_url" placeholder="https://drive.google.com/..." required class={inputCls} />
    <p class="text-xs text-gray-500 mt-1">{labels.assets_url_help}</p>
  </div>

  <label class="flex items-start gap-2 text-sm text-gray-700">
    <input type="checkbox" name="accept_terms" required class="mt-1" />
    <span>{labels.accept}</span>
  </label>

  <button
    type="submit"
    class="bg-accent-500 hover:bg-accent-600 text-white font-semibold px-8 py-3 rounded-lg transition-colors"
  >
    {labels.submit}
  </button>
</form>
