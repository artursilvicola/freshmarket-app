---
import { t, type Locale } from '../i18n/translations';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const tr = t(locale);
---
<div id="cookie-banner" class="hidden fixed bottom-4 right-4 max-w-md bg-brand-800 text-white rounded-lg shadow-2xl p-5 z-50">
  <p class="text-sm mb-3">{tr.cookies.message}</p>
  <div class="flex gap-2">
    <button id="cookie-accept" class="px-4 py-2 bg-accent-500 hover:bg-accent-600 rounded font-semibold text-sm">
      {tr.cookies.accept}
    </button>
    <button id="cookie-reject" class="px-4 py-2 border border-white/30 hover:bg-white/10 rounded text-sm">
      {tr.cookies.reject}
    </button>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  const reject = document.getElementById('cookie-reject');
  if (banner && !localStorage.getItem('cookies_consent')) {
    banner.classList.remove('hidden');
  }
  accept?.addEventListener('click', () => {
    localStorage.setItem('cookies_consent', 'accepted');
    banner?.classList.add('hidden');
  });
  reject?.addEventListener('click', () => {
    localStorage.setItem('cookies_consent', 'rejected');
    banner?.classList.add('hidden');
  });
</script>
