---
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = 'en' as const;
---

<BaseLayout title="404 — Not found" description="Page not found" locale={locale}>
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-xl">
      <p class="text-7xl font-extrabold text-brand-700 mb-2">404</p>
      <h1 class="text-3xl font-bold mb-4">This page does not exist</h1>
      <p class="text-gray-600 mb-8">
        Strona nie istnieje. The page you are looking for might have been moved or removed.
      </p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/" class="bg-brand-700 hover:bg-brand-800 text-white px-6 py-3 rounded-lg font-semibold transition">
          Go to homepage
        </a>
        <a href="/pl/" class="bg-white border-2 border-brand-700 text-brand-700 hover:bg-brand-50 px-6 py-3 rounded-lg font-semibold transition">
          Strona główna PL
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
