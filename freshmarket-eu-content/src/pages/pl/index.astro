---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const page = await getEntry('pagesPl', 'index');
if (!page) {
  throw new Error('Missing src/content/pages/pl/index.md');
}

const { Content } = await render(page);
const data = page.data;
---
<BaseLayout title={data.title} description={data.description} locale="pl">
  {data.hero && <Hero {...data.hero} />}

  <article class="container-narrow py-12 prose prose-lg max-w-none">
    <Content />
  </article>

  {data.retail_chains_2026 && (
    <section class="container-wide py-12">
      <h2 class="text-2xl font-bold text-center mb-8">Sieci handlowe na Fresh Market 2026</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-6 items-center">
        {data.retail_chains_2026.map(r => (
          <img src={r.logo} alt={r.name} class="h-16 w-auto mx-auto opacity-80 hover:opacity-100 transition" loading="lazy" />
        ))}
      </div>
    </section>
  )}

  {data.distributors_2026 && (
    <section class="container-wide py-12 bg-slate-50">
      <h2 class="text-2xl font-bold text-center mb-8">Zaproszeni dystrybutorzy i importerzy 2026</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 items-center">
        {data.distributors_2026.map(d => (
          <img src={d.logo} alt={d.name} class="h-12 w-auto mx-auto opacity-80 hover:opacity-100 transition" loading="lazy" />
        ))}
      </div>
    </section>
  )}

  {data.reviews && (
    <section class="container-wide py-12">
      <h2 class="text-2xl font-bold text-center mb-8">Opinie</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {data.reviews.map(r => (
          <blockquote class="bg-white p-6 rounded-lg shadow border border-slate-200">
            <p class="italic mb-4">"{r.quote}"</p>
            <footer class="text-sm">
              <strong>{r.author}</strong>
              <span class="block text-slate-500">{r.company}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
