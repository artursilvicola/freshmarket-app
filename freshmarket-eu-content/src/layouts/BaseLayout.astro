---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: 'en' | 'pl';
  canonical?: string;
  ogImage?: string;
}

const { title, description, locale, canonical, ogImage = '/og-default.jpg' } = Astro.props;
const siteUrl = Astro.site?.toString() || 'https://freshmarket.eu/';
const fullCanonical = canonical || new URL(Astro.url.pathname, siteUrl).toString();
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={fullCanonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />
    <meta property="og:locale" content={locale === 'pl' ? 'pl_PL' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Hreflang dla 2 języków -->
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname.replace(/^\/pl/, ''), siteUrl).toString()} />
    <link rel="alternate" hreflang="pl" href={new URL(`/pl${Astro.url.pathname.replace(/^\/pl/, '')}`, siteUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieBanner locale={locale} />
  </body>
</html>
