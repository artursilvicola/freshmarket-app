# [feat/marketing-activation] Środowisko odbiorowe — WYŁĄCZNIE osobny, testowy projekt Supabase.
# Skopiuj do `.env.test` (plik jest w .gitignore) i uzupełnij wartościami z projektu TESTOWEGO.
# Skrypty odmawiają pracy, gdy którakolwiek wartość wskazuje projekt produkcyjny.

# połączenie do bazy testowej (Supabase → Project Settings → Database → Connection string, Direct)
TEST_DATABASE_URL=postgresql://postgres:HASLO@db.REFTESTOWY.supabase.co:5432/postgres

# frontend (Vite) — projekt testowy
VITE_SUPABASE_URL=https://REFTESTOWY.supabase.co
VITE_SUPABASE_ANON_KEY=anon-key-projektu-testowego
# widoczność modułu Marketing tylko w tym buildzie
VITE_ADMIN_MARKETING_ACTIVATION=true

# funkcje Netlify (netlify dev) — projekt testowy
SUPABASE_URL=https://REFTESTOWY.supabase.co
SUPABASE_ANON_KEY=anon-key-projektu-testowego
SUPABASE_SERVICE_ROLE_KEY=service-role-key-projektu-testowego
B2B_APP_URL=http://localhost:8888
MARKETING_UNSUBSCRIBE_SECRET=sekret-testowy-min-32-znaki-nie-z-produkcji
# fikcyjny klucz: żaden mail nie wyjdzie (brak MARKETING_SEND_ENABLED → 403; klucz i tak nieprawdziwy)
RESEND_API_KEY=re_test_disabled
# MARKETING_SEND_ENABLED — NIE ustawiać
# MARKETING_SEND_ALLOWLIST — na czas próby na prawdziwych kontach: adresy oddzielone przecinkiem;
# gdy ustawiona, batch i test idą TYLKO na te adresy (reszta pomijana, test spoza listy = 403)
# MARKETING_SEND_ALLOWLIST=spiker.artur@gmail.com,artur.silvicola@gmail.com
